{
  "outputDirectory": "public",
  "functions": {
    "api/webhook.py": {
      "maxDuration": 300
    },
    "api/cron_reminders.py": {
      "maxDuration": 120
    },
    "api/cron_digest.py": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/snake",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "(?<g>[a-z]+)"
        }
      ],
      "destination": "/?game=:g",
      "permanent": false
    },
    {
      "source": "/snake",
      "destination": "/?game=snake",
      "permanent": false
    },
    {
      "source": "/snake_app.html",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "(?<g>[a-z]+)"
        }
      ],
      "destination": "/?game=:g",
      "permanent": false
    },
    {
      "source": "/snake_app.html",
      "destination": "/?game=snake",
      "permanent": false
    },
    {
      "source": "/tetris",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "(?<g>[a-z]+)"
        }
      ],
      "destination": "/?game=:g",
      "permanent": false
    },
    {
      "source": "/tetris",
      "destination": "/?game=blocks",
      "permanent": false
    },
    {
      "source": "/tetris_app.html",
      "has": [
        {
          "type": "query",
          "key": "game",
          "value": "(?<g>[a-z]+)"
        }
      ],
      "destination": "/?game=:g",
      "permanent": false
    },
    {
      "source": "/tetris_app.html",
      "destination": "/?game=blocks",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron_reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron_digest",
      "schedule": "0 6,7 * * *"
    }
  ]
}
